# Copy this file to a mode-specific env file:
# .env.development, .env.crazygames, .env.poki, .env.gamedistribution

# Core platform flags
VITE_PLATFORM=development
VITE_AD_FREE=false
VITE_CG_SDK_ONLY=false

# Firebase (kept disabled by default for now)
VITE_ENABLE_FIREBASE=false
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# GameDistribution
VITE_GD_GAME_ID=

# CrazyGames leaderboard MVP (optional)
# If set, SDK user.submitScore() is used with encrypted score payload.
VITE_CG_LB_ENCRYPTION_KEY=

# Future ad-free variant idea (leave commented until needed):
# File: .env.crazygames-noads
# VITE_PLATFORM=crazygames
# VITE_AD_FREE=true
# VITE_CG_SDK_ONLY=true
