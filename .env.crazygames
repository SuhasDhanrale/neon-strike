# CrazyGames build environment
# Used by: npm run build:crazygames  (or dev:crazygames for testing)

VITE_PLATFORM=crazygames
VITE_AD_FREE=false
VITE_CG_SDK_ONLY=false

# Firebase (keep disabled unless you wire it up)
VITE_ENABLE_FIREBASE=false

# CrazyGames leaderboard score encryption key (required for live leaderboard)
# Generate a 32-byte random base64 key from the CrazyGames dashboard and paste it below.
# Without this, scores fall back to local-only storage.
VITE_CG_LB_ENCRYPTION_KEY=
